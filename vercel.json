{
  "crons": [
    {
      "path": "/api/cron/day",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/scalp",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/swing",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/strategy-optimizer/[strategy]/day",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/strategy-optimizer/[strategy]/scalp",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/strategy-optimizer/[strategy]/swing",
      "schedule": "0 2 * * *"
    }
  ]
}
